<Window x:Class="EarthquakeShow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Earthquake Show"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="25"
                            Height="25"
                            Margin="0,0,9,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Text="震" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Earthquake Show" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,8,0"
                            Padding="9,5"
                            Background="{StaticResource OfflineSoftBrush}"
                            BorderBrush="#E3B7B2"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Foreground="{StaticResource OfflineBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="离线" />
                    </Border>
                    <Border Padding="9,5"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Text="{Binding CurrentTime}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource NavigationBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton IsChecked="True"
                                 GroupName="PrimaryNavigation"
                                 Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="20"
                                       Text="&#xE9D9;" />
                            <TextBlock Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Text="地震" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="14,12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}"
                                           Text="JMA 地震情报" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource PaneTitleTextStyle}"
                                           Text="事件列表" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Bottom"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Text="0 条" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="28"
                                   Text="&#xE8B7;" />
                        <TextBlock Margin="0,10,0,0"
                                   Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="暂无地震事件" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="本地缓存尚未建立" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <StackPanel Margin="12"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                    <Button IsEnabled="False"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTip="放大"
                            Content="+" />
                    <Button IsEnabled="False"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTip="缩小"
                            Content="−" />
                    <Button IsEnabled="False"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTip="恢复日本全图"
                            Content="⌖" />
                    <Button IsEnabled="False"
                            Style="{StaticResource MapToolButtonStyle}"
                            ToolTip="地图图层"
                            Content="层" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="38"
                               Text="&#xE707;" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource EmptyTitleTextStyle}"
                               Text="日本地图尚未加载" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource EmptyBodyTextStyle}"
                               Text="等待本地 GIS 数据" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="3"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1,0,0,0">
                <TabControl>
                    <TabItem Header="摘要">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="28"
                                       Text="&#xE9D9;" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource EmptyTitleTextStyle}"
                                       Text="未选择事件" />
                            <TextBlock Margin="0,6,0,0"
                                       Style="{StaticResource EmptyBodyTextStyle}"
                                       Text="从左侧事件列表选择一条地震情报" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="观测点">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="未选择事件" />
                    </TabItem>
                    <TabItem Header="时间线">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="未选择事件" />
                    </TabItem>
                    <TabItem Header="原始数据">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="未选择事件" />
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,0"
                Background="{StaticResource SurfaceSubtleBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding NetworkStatus}" />
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding CacheStatus}" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11">
                    <Run Text="版本 " />
                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
