<Window x:Class="EarthquakeShow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:EarthquakeShow.App.Views"
        mc:Ignorable="d"
        Title="Earthquake Show"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="16,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="174" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="25"
                            Height="25"
                            Margin="0,0,9,0"
                            Background="{StaticResource AccentBrush}"
                            CornerRadius="5">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Text="震" />
                    </Border>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Text="Earthquake Show" />
                </StackPanel>

                <Border Grid.Column="2"
                        Width="74"
                        Padding="8,5"
                        HorizontalAlignment="Center"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EarthquakePage.Display.HasOnlineSource}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OnlineSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource OnlineBorderBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EarthquakePage.Display.IsOffline}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OfflineSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#E3B7B2" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EarthquakePage.Display.HasError}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource OfflineSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="#E3B7B2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding EarthquakePage.Display.DataStatusText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EarthquakePage.Display.HasOnlineSource}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OnlineBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EarthquakePage.Display.IsOffline}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OfflineBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EarthquakePage.Display.HasError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource OfflineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding EarthquakePage.Display.LastReceivedText}"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="4"
                        AutomationProperties.Name="搜索"
                        Click="OnSearchClick"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="搜索">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE721;" />
                </Button>

                <Button Grid.Column="5"
                        AutomationProperties.Name="设置"
                        IsEnabled="False"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="设置">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE713;" />
                </Button>

                <Border Grid.Column="6"
                        Padding="9,5"
                        Background="{StaticResource SurfaceSubtleBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas"
                               FontSize="12"
                               Text="{Binding CurrentTime}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="DetailsColumn" Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource NavigationBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton IsChecked="True"
                                 GroupName="PrimaryNavigation"
                                 Style="{StaticResource NavigationButtonStyle}">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="20"
                                       Text="&#xE9D9;" />
                            <TextBlock Margin="0,3,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="11"
                                       Text="地震" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <views:EarthquakeEventListView x:Name="EventListView"
                                               DataContext="{Binding EventList}"
                                               RequestOpenDetails="OnEventListRequestOpenDetails" />
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}">
                <views:EarthquakeMapView DataContext="{Binding Map}" />
                <Button Width="34"
                        Height="34"
                        Margin="12,12,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="打开事件详情"
                        Click="OnOpenDetailsClick"
                        Panel.ZIndex="3"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="打开事件详情"
                        Visibility="{Binding Layout.IsCompactLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A0;" />
                </Button>
            </Grid>

            <Border Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Width="380"
                    HorizontalAlignment="Right"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="1,0,0,0"
                    Panel.ZIndex="4"
                    Visibility="{Binding Layout.IsDetailsPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <views:EarthquakeDetailsView x:Name="DetailsView"
                                                  DataContext="{Binding Details}" />

                    <Button Width="30"
                            Height="30"
                            Margin="0,8,8,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="关闭事件详情"
                            Click="OnCloseDetailsClick"
                            Panel.ZIndex="5"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="关闭事件详情"
                            Visibility="{Binding Layout.IsCompactLayout, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE711;" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="12,0"
                Background="{StaticResource SurfaceSubtleBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding EarthquakePage.Display.NetworkStatusText}" />
                <TextBlock Grid.Column="1"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding CacheStatus}" />
                <TextBlock Grid.Column="2"
                           MaxWidth="220"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding EarthquakePage.Display.SourceText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding MapDataStatus}" />
                <TextBlock Grid.Column="5"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11">
                    <Run Text="版本 " />
                    <Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
