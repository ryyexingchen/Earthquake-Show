<UserControl x:Class="EarthquakeShow.App.Views.TsunamiDetailsTabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TsunamiLevelBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#EEF1F2" />
            <Setter Property="BorderBrush" Value="#AEB8BC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="MinorChange">
                    <Setter Property="Background" Value="#B9DCF2" />
                    <Setter Property="BorderBrush" Value="#6AA9CB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Advisory">
                    <Setter Property="Background" Value="#F2C94C" />
                    <Setter Property="BorderBrush" Value="#B28B12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Background" Value="#D83A34" />
                    <Setter Property="BorderBrush" Value="#A7221D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="MajorWarning">
                    <Setter Property="Background" Value="#7B3FA1" />
                    <Setter Property="BorderBrush" Value="#55266F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ObservationStatusText}" Value="欠测">
                    <Setter Property="Background" Value="#202020" />
                    <Setter Property="BorderBrush" Value="#000000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ObservationStatusText}" Value="观测中">
                    <Setter Property="Background" Value="#202020" />
                    <Setter Property="BorderBrush" Value="#000000" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ObservationStatusText}" Value="微弱">
                    <Setter Property="Background" Value="#B9DCF2" />
                    <Setter Property="BorderBrush" Value="#6AA9CB" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TsunamiLevelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#354148" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="MajorWarning">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ObservationStatusText}" Value="欠测">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ObservationStatusText}" Value="观测中">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectedTsunamiLevelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TsunamiTableHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TsunamiTableListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Padding="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DDECEF" />
                    <Setter Property="BorderBrush" Value="#6A9DA8" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl x:Name="TsunamiDetailsTabs"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
        <TabItem Header="摘要">
            <ScrollViewer Padding="18,16"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="当前报文" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="{Binding SelectedReportInfoKindText}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource SelectedTsunamiLevelTextStyle}"
                               Text="{Binding SelectedReportLevelText}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding SelectedReportHeadlineText}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,16,0,0"
                            Padding="12"
                            Background="#EEF5F6"
                            BorderBrush="#A5BEC3"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="引发海啸的震源" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EarthquakeSourceText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding EarthquakeOriginTimeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="震级 / 深度" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding EarthquakeMagnitudeText}" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Text="{Binding EarthquakeDepthText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0"
                            Padding="12"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource EyebrowTextStyle}" Text="报文代码" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReport.ReportCode}" />
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource EyebrowTextStyle}" Text="状态 / 场景" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedReportStatusContextText}" />
                            <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource EyebrowTextStyle}" Text="发布时间" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedReportIssuedAtText}" />
                            <TextBlock Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource EyebrowTextStyle}" Text="接收时间" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedReportReceivedAtText}" />
                            <TextBlock Grid.Row="4" Margin="0,8,0,0" Style="{StaticResource EyebrowTextStyle}" Text="关联事件" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Text="{Binding SelectedReport.EventId}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding HasEstimationAreas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="近海推定" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding EstimationAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding Code}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding ArrivalText}" />
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding HeightText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="警报 / 预报">
            <ScrollViewer Padding="18,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding HasForecastAreas, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="海啸警报 / 预报" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="JMA 发布的分区等级和预计值" TextWrapping="Wrap" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="78" />
                            <ColumnDefinition Width="62" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource TsunamiTableHeaderStyle}" Text="等级" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TsunamiTableHeaderStyle}" Text="预报区" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TsunamiTableHeaderStyle}" Text="预计首波" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TsunamiTableHeaderStyle}" Text="最大高度" />
                    </Grid>
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding ForecastAreas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="62" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource TsunamiLevelBadgeStyle}" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource TsunamiLevelTextStyle}" Text="{Binding LevelText}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="6,0,4,0">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding Code}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding ArrivalText}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" FontSize="10" FontWeight="SemiBold" Text="{Binding HeightText}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="观测点">
            <ScrollViewer Padding="18,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Padding="12"
                            Background="#F1F7F8"
                            BorderBrush="#A5BEC3"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasSelectedObservationStation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="选中观测点" />
                                <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedObservationStation.Name}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding SelectedObservationStation.AreaName}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding SelectedObservationStation.Code}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="状态 / 高度" />
                                <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Text="{Binding SelectedObservationStation.StatusDisplayText}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" FontSize="12" Text="{Binding SelectedObservationStation.MeasuredHeightDisplayText}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding SelectedObservationStation.ArrivalText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,16,0,0"
                                Visibility="{Binding HasObservationStations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="海啸情报 / 实际观测" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding ObservationSummaryText}" TextWrapping="Wrap" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58" />
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource TsunamiTableHeaderStyle}" Text="区域" />
                            <TextBlock Grid.Column="1" Style="{StaticResource TsunamiTableHeaderStyle}" Text="观测点" />
                            <TextBlock Grid.Column="2" Style="{StaticResource TsunamiTableHeaderStyle}" Text="首波 / 高潮" />
                            <TextBlock Grid.Column="3" Style="{StaticResource TsunamiTableHeaderStyle}" Text="实测高度" />
                            <TextBlock Grid.Column="4" Style="{StaticResource TsunamiTableHeaderStyle}" Text="状态" />
                        </Grid>
                        <ListBox Margin="0,6,0,0"
                                 AutomationProperties.Name="海啸观测点表格"
                                 ItemsSource="{Binding ObservationStations}"
                                 ItemContainerStyle="{StaticResource TsunamiTableListBoxItemStyle}"
                                 SelectedItem="{Binding SelectedObservationStation, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding AreaName}" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding Code}" />
                                                <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding PublicationText}" TextWrapping="Wrap" Visibility="{Binding IsCatalogMatched, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding ArrivalText}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding HighTideText, StringFormat=高潮 {0}}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border Grid.Column="3"
                                                    Padding="4,2"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource TsunamiLevelBadgeStyle}">
                                                <TextBlock Style="{StaticResource TsunamiLevelTextStyle}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding MeasuredHeightDisplayText}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock FontSize="10" Text="{Binding StatusDisplayText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding InitialText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="时间线">
            <ScrollViewer Padding="18,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Visibility="{Binding HasTimelineReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="报文时间线" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding TimelineReports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding ReportCode}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding StatusText}" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding IssuedAtText}" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource TsunamiLevelBadgeStyle}" VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource TsunamiLevelTextStyle}" Text="{Binding LevelText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="与上一报差异" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding ReportDifferenceStatusText}" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding ReportDifferences}" Visibility="{Binding HasReportDifferences, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FieldText}" />
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                            <Run Text="{Binding PreviousText}" />
                                            <Run Text=" → " />
                                            <Run Text="{Binding CurrentText}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasInformationItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}" FontSize="15" Text="信息项" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding InformationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="9" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding KindText}" />
                                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding AreasText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="原始数据">
            <Grid Margin="14" Visibility="{Binding HasRawXml, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding RawXmlCopyStatus}" />
                    <Button Padding="10,4" AutomationProperties.Name="复制原始 XML" Click="OnCopyRawXmlClick" IsEnabled="{Binding CanCopyRawXml}" Content="复制" ToolTip="复制原始 XML" />
                </StackPanel>
                <TextBlock Grid.Row="1" Margin="0,6,0,8" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="当前 VTSE 报文的原始 XML，仅供核对字段。" />
                <TextBox Grid.Row="2"
                         FontFamily="Consolas"
                         FontSize="11"
                         IsReadOnly="True"
                         Padding="8"
                         HorizontalScrollBarVisibility="Auto"
                         VerticalScrollBarVisibility="Auto"
                         Text="{Binding RawXmlText, Mode=OneWay}"
                         TextWrapping="NoWrap" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
