<UserControl x:Class="EarthquakeShow.App.Views.EarthquakeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="380"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <TabControl x:Name="DetailsTabs">
        <TabItem Header="摘要">
            <Grid>
                <StackPanel MaxWidth="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="28"
                               Text="&#xE9D9;" />
                    <TextBlock Margin="0,10,0,0"
                               Style="{StaticResource EmptyTitleTextStyle}"
                               Text="未选择事件" />
                    <TextBlock Margin="0,6,0,0"
                               Style="{StaticResource EmptyBodyTextStyle}"
                               Text="请从左侧事件列表选择一条记录"
                               TextAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{Binding HasReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="16,15,44,13"
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="{Binding SnapshotText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="16,12,16,8"
                                      Grid.IsSharedSizeScope="True"
                                      ItemsSource="{Binding SummaryFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" SharedSizeGroup="SummaryLabel" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Value}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2"
                            Padding="12,10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Padding="12,6"
                                    AutomationProperties.Name="定位当前报文震源"
                                    Click="OnFocusHypocenterClick"
                                    Content="定位震源"
                                    IsEnabled="{Binding CanLocateHypocenter}" />
                            <Button Margin="8,0,0,0"
                                    Padding="12,6"
                                    AutomationProperties.Name="复制事件 ID"
                                    Click="OnCopyEventIdClick"
                                    Content="复制事件 ID" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="观测点">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0"
                         Padding="8,6"
                         AutomationProperties.Name="搜索当前报文观测"
                         Text="{Binding ObservationSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜索区域、市町村、观测点名称或代码" />
                <Grid Grid.Row="1" Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              Content="仅看最高震度"
                              IsChecked="{Binding ShowHighestOnly}" />
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding ObservationCountText}" />
                </Grid>
                <ListView Grid.Row="2"
                          AutomationProperties.Name="区域与观测点"
                          ItemsSource="{Binding Observations}"
                          SelectedItem="{Binding SelectedObservation}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Width="43" DisplayMemberBinding="{Binding IntensityText}" Header="震度" />
                            <GridViewColumn Width="55" DisplayMemberBinding="{Binding Kind}" Header="类别" />
                            <GridViewColumn Width="155" DisplayMemberBinding="{Binding Name}" Header="名称" />
                            <GridViewColumn Width="72" DisplayMemberBinding="{Binding LocationText}" Header="地图" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>

        <TabItem Header="时间线">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Padding="12,10"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                AutomationProperties.Name="上一报"
                                Click="OnPreviousReportClick"
                                IsEnabled="{Binding CanGoPrevious}"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                ToolTip="上一报">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72B;" />
                        </Button>
                        <Button Grid.Column="1"
                                Margin="4,0,0,0"
                                AutomationProperties.Name="下一报"
                                Click="OnNextReportClick"
                                IsEnabled="{Binding CanGoNext}"
                                Style="{StaticResource HeaderIconButtonStyle}"
                                ToolTip="下一报">
                            <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72A;" />
                        </Button>
                        <Button Grid.Column="2"
                                Margin="6,0,0,0"
                                Padding="10,5"
                                AutomationProperties.Name="返回最新报文"
                                Click="OnReturnToLatestClick"
                                Content="返回最新"
                                IsEnabled="{Binding CanReturnToLatest}" />
                        <Button Grid.Column="4"
                                Padding="10,5"
                                AutomationProperties.Name="查看当前原始数据"
                                Click="OnShowRawDataClick"
                                Content="原始数据" />
                    </Grid>
                </Border>
                <ListBox Grid.Row="1"
                         Padding="8"
                         AutomationProperties.Name="报文时间线"
                         BorderThickness="0"
                         ItemsSource="{Binding TimelineItems}"
                         SelectedItem="{Binding SelectedTimelineItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,9"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ReportTypeText}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11">
                                        <Run Text="{Binding SerialText}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding SourceId}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding IssuedAtText}" />
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding ReceivedAtText}" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="11"
                                               Text="{Binding ChangeSummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <TabItem Header="原始数据">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="WrapRawTextToggle"
                              Grid.Column="1"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Checked="OnRawWrapChanged"
                              Content="自动换行"
                              Unchecked="OnRawWrapChanged" />
                    <Button Grid.Column="2"
                            Width="32"
                            Height="32"
                            AutomationProperties.Name="复制原始数据"
                            Click="OnCopyRawDataClick"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="复制原始数据">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8C8;" />
                    </Button>
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="0,6,0,8"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="{Binding RawMetadataText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox x:Name="RawPayloadTextBox"
                         Grid.Row="2"
                         Padding="8"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         AutomationProperties.Name="只读原始报文"
                         FontFamily="Consolas"
                         FontSize="11"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="{Binding RawPayload, Mode=OneWay}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
