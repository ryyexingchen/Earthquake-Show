<UserControl x:Class="EarthquakeShow.App.Views.EarthquakeEventListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="280"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="EventListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,0,10,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="34" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="JMA 地震情报" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="事件列表" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="4,0,4,3"
                           VerticalAlignment="Bottom"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="{Binding ResultCountText}" />
                <Button Grid.Column="2"
                        AutomationProperties.Name="刷新地震事件"
                        Click="OnRefreshClick"
                        IsEnabled="{Binding CanRefresh}"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="刷新地震事件">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="10,10,10,8">
            <TextBox x:Name="SearchBox"
                     Height="32"
                     Padding="9,5"
                     AutomationProperties.Name="搜索地震事件"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="搜索事件、震源、报文代码或来源" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          AutomationProperties.Name="事件排序"
                          DisplayMemberPath="Label"
                          ItemsSource="{Binding SortOptions}"
                          SelectedValue="{Binding SortOrder}"
                          SelectedValuePath="Value"
                          Style="{StaticResource FilterComboBoxStyle}" />
                <Button Grid.Column="2"
                        Height="30"
                        AutomationProperties.Name="清除搜索和筛选"
                        Click="OnClearFiltersClick"
                        IsEnabled="{Binding HasActiveFilters}"
                        ToolTip="清除搜索和筛选">
                    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE894;" />
                </Button>
            </Grid>

            <Expander Margin="0,8,0,0" Header="筛选">
                <Grid Margin="0,7,0,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="7" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Row="0"
                              Grid.Column="0"
                              AutomationProperties.Name="时间范围筛选"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding TimeRangeOptions}"
                              SelectedValue="{Binding TimeRange}"
                              SelectedValuePath="Value"
                              Style="{StaticResource FilterComboBoxStyle}" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="2"
                              AutomationProperties.Name="最低震度筛选"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding IntensityOptions}"
                              SelectedValue="{Binding MinimumIntensity}"
                              SelectedValuePath="Value"
                              Style="{StaticResource FilterComboBoxStyle}" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="0"
                              AutomationProperties.Name="最低震级筛选"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding MagnitudeOptions}"
                              SelectedValue="{Binding MinimumMagnitude}"
                              SelectedValuePath="Value"
                              Style="{StaticResource FilterComboBoxStyle}" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="2"
                              AutomationProperties.Name="来源筛选"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding SourceOptions}"
                              SelectedValue="{Binding SourceId}"
                              SelectedValuePath="Value"
                              Style="{StaticResource FilterComboBoxStyle}" />
                    <TextBox Grid.Row="4"
                             Grid.Column="0"
                             Grid.ColumnSpan="3"
                             Height="30"
                             Padding="8,4"
                             AutomationProperties.Name="区域筛选"
                             Text="{Binding RegionText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按震源、区域、市町村或观测点筛选" />
                </Grid>
            </Expander>
        </StackPanel>

        <ListBox Grid.Row="2"
                 AutomationProperties.Name="地震事件列表"
                 ItemsSource="{Binding Items}"
                 ItemContainerStyle="{StaticResource EventListBoxItemStyle}"
                 PreviewKeyDown="OnEventListPreviewKeyDown"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsContainerVirtualizable="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Visibility="{Binding HasResults, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Card"
                            Padding="10"
                            Background="{StaticResource SurfaceSubtleBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="IntensityBadge"
                                    Grid.RowSpan="4"
                                    Width="36"
                                    Height="36"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="#E6EBEF"
                                    BorderBrush="#39454C"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Text="{Binding IntensityText}" />
                            </Border>

                            <Grid Grid.Row="0" Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Padding="4,1"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="3"
                                        Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Foreground="{StaticResource AccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="新" />
                                </Border>
                            </Grid>
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Text="{Binding OriginTimeText}"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="{Binding MagnitudeText}" />
                                <TextBlock Grid.Column="1"
                                           Margin="7,0,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="{Binding ReportText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="{Binding UpdatedAtText}" />
                            </Grid>
                            <TextBlock Grid.Row="3"
                                       Grid.Column="1"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Text="{Binding TsunamiText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                     Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="One">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#78C7D8" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="Two">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#70D6C1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="Three">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#F0C943" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="Four">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#E89A3C" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="FiveLower">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#E85E3F" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="FiveUpper">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#F04438" />
                            <Setter TargetName="IntensityBadge" Property="BorderBrush" Value="White" />
                            <Setter TargetName="IntensityBadge" Property="TextElement.Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="SixLower">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#B51255" />
                            <Setter TargetName="IntensityBadge" Property="BorderBrush" Value="White" />
                            <Setter TargetName="IntensityBadge" Property="TextElement.Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="SixUpper">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#8E24AA" />
                            <Setter TargetName="IntensityBadge" Property="BorderBrush" Value="White" />
                            <Setter TargetName="IntensityBadge" Property="TextElement.Foreground" Value="White" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MaxIntensity}" Value="Seven">
                            <Setter TargetName="IntensityBadge" Property="Background" Value="#4A148C" />
                            <Setter TargetName="IntensityBadge" Property="BorderBrush" Value="White" />
                            <Setter TargetName="IntensityBadge" Property="TextElement.Foreground" Value="White" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    MaxWidth="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="28"
                       Text="&#xE896;" />
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource EmptyTitleTextStyle}"
                       Text="正在读取事件" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource EmptyBodyTextStyle}"
                       Text="请稍候" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    MaxWidth="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowErrorState}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowRepositoryEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowNoResults}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontFamily="Segoe Fluent Icons"
                       FontSize="28"
                       Text="&#xE8B7;" />
            <TextBlock Margin="0,10,0,0"
                       Style="{StaticResource EmptyTitleTextStyle}"
                       Text="{Binding EmptyTitle}" />
            <TextBlock Margin="0,6,0,0"
                       Style="{StaticResource EmptyBodyTextStyle}"
                       Text="{Binding EmptyMessage}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
