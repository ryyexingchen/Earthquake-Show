<UserControl x:Class="EarthquakeShow.App.Views.EarthquakeMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="700"
             mc:Ignorable="d">
    <Grid Background="#B7D4E2">
        <Canvas x:Name="MapCanvas" ClipToBounds="True" />

        <Border Margin="12"
                Padding="9,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#F4F7F8"
                BorderBrush="#C5D0D4"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <TextBlock FontSize="12"
                           FontWeight="SemiBold"
                           Text="JMA 地震区域概览" />
                <TextBlock Margin="0,3,0,0"
                           Foreground="#667179"
                           FontSize="10"
                           Text="{Binding StatusText}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <Button AutomationProperties.Name="放大地图"
                    Click="OnZoomInClick"
                    Style="{StaticResource MapToolButtonStyle}"
                    ToolTip="放大地图">
                <TextBlock FontSize="17" Text="+" />
            </Button>
            <Button AutomationProperties.Name="缩小地图"
                    Click="OnZoomOutClick"
                    Style="{StaticResource MapToolButtonStyle}"
                    ToolTip="缩小地图">
                <TextBlock FontSize="17" Text="−" />
            </Button>
            <Button AutomationProperties.Name="恢复日本全图"
                    Click="OnResetViewClick"
                    Style="{StaticResource MapToolButtonStyle}"
                    ToolTip="恢复日本全图">
                <TextBlock FontSize="16" Text="⌂" />
            </Button>
            <Button AutomationProperties.Name="定位所选事件"
                    Click="OnFocusSelectedClick"
                    IsEnabled="{Binding HasSelectedEvent}"
                    Style="{StaticResource MapToolButtonStyle}"
                    ToolTip="定位所选事件">
                <TextBlock FontSize="15" Text="⌖" />
            </Button>
            <CheckBox Margin="0,3,5,0"
                      HorizontalAlignment="Right"
                      AutomationProperties.Name="跟随事件选择"
                      Click="OnFollowSelectionClick"
                      IsChecked="{Binding FollowSelection, Mode=OneWay}"
                      ToolTip="选中事件时自动定位地图">
                <TextBlock Margin="4,0,0,0"
                           Background="#F4F7F8"
                           Foreground="#667179"
                           FontSize="10"
                           Text="跟随" />
            </CheckBox>
        </StackPanel>

        <Border Margin="12"
                Width="66"
                Padding="6,7"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#F4F7F8"
                BorderBrush="#C5D0D4"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <TextBlock Foreground="#667179"
                           FontSize="10"
                           Text="震度" />
                <StackPanel Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#E1E5E7" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="不明" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#DCEFF7" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="1" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#BFE8DB" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="2" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#F4E59C" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="3" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#F4C37D" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="4" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#EB9B76" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="5-" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#E17467" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="5+" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#C95567" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="6-" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#963F68" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="6+" />
                    </StackPanel>
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <Border Width="14" Height="10" Background="#5D315D" CornerRadius="2" />
                        <TextBlock Margin="5,0,0,0" FontSize="10" Text="7" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border MaxWidth="260"
                Margin="12"
                Padding="10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#F4F7F8"
                BorderBrush="#C5D0D4"
                BorderThickness="1"
                CornerRadius="5">
            <StackPanel>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="#667179"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="24"
                           Text="&#xE707;" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="当前事件没有可绘制坐标" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="#667179"
                           FontSize="10"
                           Text="震源或观测点坐标未知，详情中仍保留原始记录。"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasSelectedEvent}" Value="True" />
                                <Condition Binding="{Binding HasDrawableLayers}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
