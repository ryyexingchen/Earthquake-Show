<UserControl x:Class="EarthquakeShow.App.Views.TsunamiPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="720"
             d:DesignWidth="1440"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TsunamiListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,0,10,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="10"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="JMA 海啸情报" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="报文查询" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding ResultCountText}" />
                    <Button Width="32"
                            Height="32"
                            AutomationProperties.Name="刷新海啸报文"
                            Click="OnRefreshClick"
                            IsEnabled="{Binding CanRefresh}"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="刷新海啸报文">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <ListBox AutomationProperties.Name="海啸报文列表"
                             ItemsSource="{Binding Reports}"
                             ItemContainerStyle="{StaticResource TsunamiListBoxItemStyle}"
                             SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ReportCode}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding Status}" />
                                    </Grid>
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               Text="{Binding InfoKind, TargetNullValue=海啸报文}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding IssuedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="{Binding EventId}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="正在读取海啸报文" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="暂无海啸报文" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="刷新后会从 JMA Feed 获取报文" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="海啸报文读取失败" />
                        <TextBlock Margin="0,6,0,0"
                                   MaxWidth="260"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="{Binding EmptyMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Padding="24,20"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="当前报文" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="{Binding SelectedReportInfoKindText}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding SelectedReportHeadlineText}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource EyebrowTextStyle}" Text="报文代码" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReport.ReportCode}" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="状态 / 场景" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportStatusContextText}" />
                            <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="发布时间" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportIssuedAtText}" />
                            <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="接收时间" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportReceivedAtText}" />
                            <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="结构数量" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportStructureText}" />
                            <TextBlock Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="报文身份" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportIdentityText}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
