<UserControl x:Class="EarthquakeShow.App.Views.TsunamiPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:EarthquakeShow.App.Views"
             d:DesignHeight="720"
             d:DesignWidth="1440"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="TsunamiListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="10,0,10,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="10"
                                Background="{StaticResource SurfaceSubtleBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TsunamiLevelBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Background" Value="#EEF1F2" />
            <Setter Property="BorderBrush" Value="#AEB8BC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="MinorChange">
                    <Setter Property="Background" Value="#B9DCF2" />
                    <Setter Property="BorderBrush" Value="#6AA9CB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Advisory">
                    <Setter Property="Background" Value="#F2C94C" />
                    <Setter Property="BorderBrush" Value="#B28B12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Background" Value="#D83A34" />
                    <Setter Property="BorderBrush" Value="#A7221D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="MajorWarning">
                    <Setter Property="Background" Value="#7B3FA1" />
                    <Setter Property="BorderBrush" Value="#55266F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="NoConcern">
                    <Setter Property="Background" Value="#E7EAEC" />
                    <Setter Property="BorderBrush" Value="#AEB8BC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TsunamiLevelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#354148" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="MajorWarning">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedTsunamiLevelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportLevel}" Value="Warning">
                    <Setter Property="Foreground" Value="#D83A34" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedReportLevel}" Value="MajorWarning">
                    <Setter Property="Foreground" Value="#7B3FA1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedReportLevel}" Value="Advisory">
                    <Setter Property="Foreground" Value="#9A7600" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedReportLevel}" Value="MinorChange">
                    <Setter Property="Foreground" Value="#397C9E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TsunamiTableHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="18,12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="JMA 海啸情报" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="报文查询" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Text="{Binding ResultCountText}" />
                    <Button Width="32"
                            Height="32"
                            AutomationProperties.Name="刷新海啸报文"
                            Click="OnRefreshClick"
                            IsEnabled="{Binding CanRefresh}"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="刷新海啸报文">
                        <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <ListBox AutomationProperties.Name="海啸报文列表"
                             ItemsSource="{Binding Reports}"
                             ItemContainerStyle="{StaticResource TsunamiListBoxItemStyle}"
                             SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding HasReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ReportCode}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding Status}" />
                                    </Grid>
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{StaticResource TextBrush}"
                                               FontSize="12"
                                               Text="{Binding InfoKind, TargetNullValue=海啸报文}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="{Binding IssuedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss zzz}}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="{Binding EventId}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="正在读取海啸报文" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="暂无海啸报文" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="刷新后会从 JMA Feed 获取报文" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource EmptyTitleTextStyle}"
                                   Text="海啸报文读取失败" />
                        <TextBlock Margin="0,6,0,0"
                                   MaxWidth="260"
                                   Style="{StaticResource EmptyBodyTextStyle}"
                                   Text="{Binding EmptyMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1"
                          Padding="24,20"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <views:TsunamiMapView Margin="0,0,0,18"
                                          DataContext="{Binding}"
                                          Visibility="{Binding HasMapGeometry, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Margin="0,0,0,18"
                            Padding="14"
                            Background="#F1F7F8"
                            BorderBrush="#A5BEC3"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding HasSelectedObservationStation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="选中观测点" />
                                <TextBlock Margin="0,4,0,0" FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedObservationStation.Name}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding SelectedObservationStation.AreaName}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding SelectedObservationStation.Code}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding SelectedObservationStation.PublicationText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="状态" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedObservationStation.ObservationStatusText}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding SelectedObservationStation.InitialText}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="观测高度" />
                                <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedObservationStation.HeightText}" />
                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding SelectedObservationStation.HighTideText, StringFormat=高潮 {0}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="首波" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding SelectedObservationStation.ArrivalText}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel MaxWidth="760"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource EyebrowTextStyle}"
                               Text="当前报文" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource PaneTitleTextStyle}"
                               Text="{Binding SelectedReportInfoKindText}" />
                    <TextBlock Margin="0,7,0,0"
                               Style="{StaticResource SelectedTsunamiLevelTextStyle}"
                               Text="{Binding SelectedReportLevelText}" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="{Binding SelectedReportHeadlineText}"
                               TextWrapping="Wrap" />

                    <Border Margin="0,16,0,0"
                            Padding="14"
                            Background="#EEF5F6"
                            BorderBrush="#A5BEC3"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="引发海啸的震源" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EarthquakeSourceText}" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding EarthquakeOriginTimeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="震级" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EarthquakeMagnitudeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="深度" />
                                <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding EarthquakeDepthText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="22,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowTextStyle}" Text="关联事件" />
                                <TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding SelectedReport.EventId}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="14"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource EyebrowTextStyle}" Text="报文代码" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedReport.ReportCode}" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="状态 / 场景" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportStatusContextText}" />
                            <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="发布时间" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportIssuedAtText}" />
                            <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="接收时间" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportReceivedAtText}" />
                            <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="结构数量" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportStructureText}" />
                            <TextBlock Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource EyebrowTextStyle}" Text="报文身份" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,10,0,0" Text="{Binding SelectedReportIdentityText}" TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasTimelineReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="报文时间线" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding TimelineReports}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="12"
                                                Height="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Style="{StaticResource TsunamiLevelBadgeStyle}" />
                                        <Border Grid.Column="1"
                                                Padding="10"
                                                Background="{StaticResource SurfaceBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding ReportCode}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding StatusText}" />
                                                        <TextBlock Margin="8,0,0,0"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   Text="{Binding ContextText}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Text="{Binding IssuedAtText}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               FontSize="11"
                                                               Text="{Binding StructureText}" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource TsunamiLevelBadgeStyle}"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource TsunamiLevelTextStyle}"
                                                               Text="{Binding LevelText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasSelectedReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="与上一报差异" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="{Binding ReportDifferenceStatusText}" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ReportDifferences}"
                                      Visibility="{Binding HasReportDifferences, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold"
                                                       Text="{Binding FieldText}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       TextWrapping="Wrap">
                                                <Run Text="{Binding PreviousText}" />
                                                <Run Text=" → " />
                                                <Run Text="{Binding CurrentText}" />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasInformationItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="信息项" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding InformationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding KindText}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding CodeText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding LastKindText}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Text="{Binding AreasText}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Expander Margin="0,18,0,0"
                              Header="原始 XML"
                              IsExpanded="False"
                              Visibility="{Binding HasRawXml, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="220" />
                            </Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11"
                                           Text="{Binding RawXmlCopyStatus}" />
                                <Button Padding="10,4"
                                        AutomationProperties.Name="复制原始 XML"
                                        Click="OnCopyRawXmlClick"
                                        IsEnabled="{Binding CanCopyRawXml}"
                                        Content="复制"
                                        ToolTip="复制原始 XML" />
                            </StackPanel>
                            <TextBox Grid.Row="1"
                                     Margin="0,8,0,0"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     IsReadOnly="True"
                                     Padding="8"
                                     HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding RawXmlText, Mode=OneWay}"
                                     TextWrapping="NoWrap" />
                        </Grid>
                    </Expander>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasForecastAreas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="预报 / 警报区域" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="显示 JMA 发布的分区、等级、预计到达和最大预计高度" TextWrapping="Wrap" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ForecastAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Style="{StaticResource TsunamiLevelBadgeStyle}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Style="{StaticResource TsunamiLevelTextStyle}"
                                                           Text="{Binding LevelText}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding Code}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding ArrivalText}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding HeightText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasObservationStations, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="实际观测" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding ObservationSummaryText}" />
                        <Border Margin="0,8,0,0" Padding="10" Background="{StaticResource SurfaceSubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource TsunamiTableHeaderStyle}" Text="都府道县 / 区域" />
                                <TextBlock Grid.Column="1" Style="{StaticResource TsunamiTableHeaderStyle}" Text="观测点" />
                                <TextBlock Grid.Column="2" Style="{StaticResource TsunamiTableHeaderStyle}" Text="首波 / 高潮" />
                                <TextBlock Grid.Column="3" Style="{StaticResource TsunamiTableHeaderStyle}" Text="实时高度" />
                                <TextBlock Grid.Column="4" Style="{StaticResource TsunamiTableHeaderStyle}" Text="观测状态" />
                            </Grid>
                        </Border>
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding ObservationStations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding AreaName}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="区域" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding Code}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding PublicationText}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding IsCatalogMatched, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="{Binding ArrivalText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding HighTideText, StringFormat=高潮 {0}}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding HeightText}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding ObservationStatusText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Border Style="{StaticResource TsunamiLevelBadgeStyle}" VerticalAlignment="Top">
                                                    <TextBlock Style="{StaticResource TsunamiLevelTextStyle}" Text="{Binding ObservationStatusText}" />
                                                </Border>
                                                <TextBlock Margin="10,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="{Binding InitialText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasEstimationAreas, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource PaneTitleTextStyle}"
                                   FontSize="15"
                                   Text="近海推定" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding EstimationAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="10"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="10"
                                                           Text="{Binding Code}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding ArrivalText}" />
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding HeightText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
