<UserControl x:Class="EarthquakeShow.App.Views.TsunamiMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="260">
    <Border Background="#D9EEF3"
            BorderBrush="#8EAAB3"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid x:Name="MapCanvas"
              Background="#D9EEF3"
              ClipToBounds="True"
              SizeChanged="OnMapSizeChanged"
              MouseLeftButtonDown="OnMapMouseLeftButtonDown"
              MouseLeftButtonUp="OnMapMouseLeftButtonUp"
              MouseMove="OnMapMouseMove"
              LostMouseCapture="OnMapLostMouseCapture"
              MouseWheel="OnMapMouseWheel">
            <Canvas x:Name="MapContentCanvas"
                    Background="Transparent">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="MapZoomTransform" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="MapPanTransform" />
                    </TransformGroup>
                </Canvas.RenderTransform>
            </Canvas>
            <Border Margin="10"
                    Padding="8,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#EAF4F5"
                    BorderBrush="#9EB8BF"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="海啸预报区" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="#53666D"
                               FontSize="10">
                        <Run Text="JMA 沿岸线 · " />
                        <Run Text="{Binding MapStatusText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
            <StackPanel Margin="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button AutomationProperties.Name="放大海啸地图"
                        Click="OnZoomInClick"
                        Style="{StaticResource MapToolButtonStyle}"
                        ToolTip="放大海啸地图">
                    <TextBlock FontSize="17" Text="+" />
                </Button>
                <Button AutomationProperties.Name="缩小海啸地图"
                        Click="OnZoomOutClick"
                        Style="{StaticResource MapToolButtonStyle}"
                        ToolTip="缩小海啸地图">
                    <TextBlock FontSize="17" Text="−" />
                </Button>
                <Button AutomationProperties.Name="恢复海啸地图视图"
                        Click="OnResetZoomClick"
                        Style="{StaticResource MapToolButtonStyle}"
                        ToolTip="恢复海啸地图视图">
                    <TextBlock FontSize="16" Text="⌂" />
                </Button>
            </StackPanel>
            <Border x:Name="LegendPanel"
                    Margin="10"
                    Padding="8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#EAF4F5"
                    BorderBrush="#9EB8BF"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="等级" />
                    <StackPanel x:Name="LegendItemsPanel" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
